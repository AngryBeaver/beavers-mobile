{
  "name": "beavers-mobile",
  "title": "Beaver's Mobile",
  "version": "3.0.0",
  "description": "The dnd5e character sheet in a mobile edition: one column, as wide as a phone, full screen on phones.",
  "devDir": "c:\\vtts\\v14.368\\Data\\modules",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node build.mjs build",
    "watch": "node build.mjs watch",
    "clean": "node build.mjs clean",
    "devbuild": "node build.mjs dev",
    "devwatch": "node build.mjs devwatch",
    "release": "node build.mjs zip",
    "tag": "git tag -d ${npm_package_name}_${npm_package_version} 2>/dev/null ; git tag ${npm_package_name}_${npm_package_version} && git push -f origin ${npm_package_name}_${npm_package_version}",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "prettier": {
    "tabWidth": 2,
    "semi": true,
    "quoteProps": "consistent",
    "trailingComma": "all",
    "printWidth": 120
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^2"
  },
  "packageManager": "pnpm@10.33.0"
}
