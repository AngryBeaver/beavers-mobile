<form>
    <div class="form-group">
        <label>{{localize "beaversMobile.settings.disableItemDrag.users.label"}}</label>
        <div class="form-fields" style="display:block">
            {{#each users as |u|}}
                <label style="display:block">
                    <input type="checkbox" name="user_{{u.id}}" {{#if u.selected}}checked{{/if}}/> {{u.name}}
                </label>
            {{/each}}
        </div>
        <p class="notes">{{localize "beaversMobile.settings.disableItemDrag.users.notes"}}</p>
    </div>

    <footer class="sheet-footer">
        <button type="submit" name="submit" class="dialog-button default">
            <i class="fas fa-save"></i> {{localize "SETTINGS.Save"}}
        </button>
    </footer>
</form>